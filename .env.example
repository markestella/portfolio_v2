# SMTP Configuration for Contact Form
# Configure these values in your Vercel project settings

# SMTP Server Settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=your-email@gmail.com
SMTP_FROM_NAME=Mark Estella

# Email to receive contact form submissions
CONTACT_EMAIL=mark.estella09@gmail.com
CONTACT_SITE_URL=https://mckbyte.com
AUTO_REPLY_ENABLED=true

# Stores visitor keys that already sent one contact message.
# Docker Compose persists /app/data with the portfolio-v2-data volume.
CONTACT_RATE_LIMIT_STORE_PATH=/app/data/contact-rate-limit.json
